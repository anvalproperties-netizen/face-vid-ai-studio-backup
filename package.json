{
  "name": "face-vid-monorepo",
  "private": true,
  "version": "0.1.0-phase1a",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node --import tsx server.ts",
    "build": "vite build",
    "build:web": "npm --prefix apps/web run build",
    "build:admin": "npm --prefix apps/admin run build",
    "build:api": "npm --prefix apps/api run build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js apps/api/dist apps/web/.next apps/admin/.next",
    "lint": "tsc --noEmit && tsx scripts/check-secrets.ts && tsx scripts/validate-platforms.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/run-tests.ts",
    "db:migrate": "tsx scripts/migrate-postgres.ts",
    "infra:verify": "tsx scripts/verify-external-infra.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "validate:docker": "tsx scripts/validate-docker.ts",
    "validate:platforms": "tsx scripts/validate-platforms.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
